# ==========================================================
# Database (Hosted Neon PostgreSQL)
# ==========================================================
# Paste your Neon connection string below (ensure ?sslmode=require is included):
DATABASE_URL=postgresql://neondb_owner:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# ==========================================================
# Code Execution Sandbox (Judge0 on RapidAPI)
# ==========================================================
# RapidAPI Judge0 endpoint & API key:
JUDGE0_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your_rapidapi_key_here
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com

# ==========================================================
# Security & JWT Auth
# ==========================================================
JWT_SECRET=super-secret-jwt-key-for-ai-exam-proctor-2026-production-ready
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=120

# ==========================================================
# LLM Integration (OpenAI or Anthropic)
# ==========================================================
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ==========================================================
# Face Recognition & Proctoring
# ==========================================================
FACE_MATCH_THRESHOLD=0.60
DEEPFACE_MODEL=ArcFace

# ==========================================================
# CORS & URLs
# ==========================================================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
